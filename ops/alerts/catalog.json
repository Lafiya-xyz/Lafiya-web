    {
      "id": "payout_reconciliation_mismatch",
      "severity": "page",
      "owner": "payouts owner",
      "runbook": "docs/chw-payout-indexer.md",
      "source": "lib/stellar/payout-indexer/reconciliation.ts"
    }
