# Supabase (see Lafiya Organization > Shared Contracts in README.md).
# NEXT_PUBLIC_-prefixed vars are safe to expose to the browser (the
# anon key is designed for client use and is enforced by RLS).
# Local dev default: run `supabase start` and use the fixed local demo
# values it prints (also mirrored in .env.test for integration tests).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stellar / Soroban (M1+, currently unused by lafiya-web — see
# lafiya-contracts). Kept here because .env.example is the documented
# cross-repo config template.
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
ATTESTATION_CONTRACT_ID=
# Only set true in local fixtures. Production startup rejects this value.
ATTESTATION_MOCK_MODE=false
ATTESTATION_CACHE_TTL_SECONDS=120

# CHW payout indexer (all required when the scheduled endpoint is enabled).
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_USDC_ISSUER=
CHW_INCENTIVE_POOL_ADDRESS=
PAYOUT_INDEXER_START_LEDGER=
PAYOUT_INDEXER_START_PAYMENT_CURSOR=0
PAYOUT_INDEXER_CRON_SECRET=
