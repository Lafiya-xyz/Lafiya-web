# ---------------------------------------------------------------------------
# Environment variables for local development.
#
# Copy this file to `.env.local` and fill in the values you need:
#
#   cp .env.example .env.local
#
# The devcontainer bootstrap script (scripts/devcontainer-bootstrap.sh) writes
# a ready-to-use `.env.local` for the local Supabase + Stellar quickstart
# stack, so you normally do not need to edit this file by hand when working
# inside the devcontainer.
# ---------------------------------------------------------------------------

# --- Supabase (local stack) -------------------------------------------------
# Defaults exposed by `supabase start` inside the devcontainer.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stellar / Soroban (M1+, currently unused by lafiya-web — see
# lafiya-contracts). Kept here because .env.example is the documented
# cross-repo config template.
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
ATTESTATION_CONTRACT_ID=
ATTESTATION_CACHE_TTL_SECONDS=120
# Comma-separated governance-approved attestation contract WASM hashes (64 hex
# chars each). An upgrade to any other hash degrades verified badges and
# alerts operators. See docs/attestation-contract-governance.md section 12.
ATTESTATION_APPROVED_WASM_HASHES=
# Server-only secret (32+ chars) for keyed duplicate-account blocking keys
# (issue #628). Leave empty to disable duplicate detection and merges.
ACCOUNT_LINKAGE_HMAC_SECRET=

# The deployment identity is a fail-closed guard for mock attestation. Local
# development may use mock mode; CI must set `ci`; production/mainnet requires
# `live`, a current protocol epoch, a managed intent-signing key, a build
# revision, and the matching application schema compatibility value.
LAFIYA_DEPLOYMENT_ENV=development
ATTESTATION_MODE=mock
CHW_PROTOCOL_EPOCH_ID=
CHW_PROTOCOL_INTENT_SIGNING_KEY=
LAFIYA_BUILD_REVISION=
LAFIYA_SCHEMA_COMPATIBILITY=

# Observability is opt-in outside production. Production/mainnet requires it
# and one DSN. Only the public ingest DSN may be exposed to the client; never
# expose an auth token or server-only DSN there.
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Phone-number OTP sign-in (Issue #530).
# Set NEXT_PUBLIC_PHONE_OTP_ENABLED=true to show the phone sign-in tab.
# Requires Twilio (or Termii via HTTP hook) configured in supabase/config.toml.
# Allowed regions: comma-separated ISO 3166-1 alpha-2 codes (e.g. NG,GH).
# Defaults to NG only when not set.
NEXT_PUBLIC_PHONE_OTP_ENABLED=false
PHONE_OTP_ALLOWED_REGIONS=NG
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# CHW payout indexer. Set PAYOUT_INDEXER_ENABLED=true only when every value in
# this group is configured. A partial or disabled-but-populated group fails at
# startup rather than silently disabling settlement tracking.
PAYOUT_INDEXER_ENABLED=false
STELLAR_HORIZON_URL=
STELLAR_USDC_ISSUER=
STELLAR_USDC_ASSET_CODE=
CHW_INCENTIVE_POOL_ADDRESS=
PAYOUT_INDEXER_START_LEDGER=
PAYOUT_INDEXER_START_PAYMENT_CURSOR=
PAYOUT_INDEXER_CRON_SECRET=
PAYOUT_INDEXER_CRON_SECRET_PREVIOUS=
