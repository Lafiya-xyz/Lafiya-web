  "engines": {
    "node": "24.14.0",
    "npm": "11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:client-bundles": "node scripts/check-client-bundles.js",
    "postbuild": "npm run check:client-bundles",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "migration:lint": "node scripts/lint-migrations.mjs",
    "ci:check-action-pins": "node scripts/check-action-pins.mjs",
    "ci:check-clean-worktree": "node scripts/check-clean-worktree.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "release:verify-gate": "node scripts/verify-release-gate.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.70.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.2",
    "libphonenumber-js": "^1.13.11",
    "next": "16.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
