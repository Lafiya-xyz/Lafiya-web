{
  "name": "lafiya-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:sw && next build",
    "build:sw": "node scripts/build-sw.mjs",
    "check:client-bundles": "node scripts/check-client-bundles.js",
    "sw:manifest": "node scripts/generate-sw-manifest.mjs",
    "postbuild": "npm run check:client-bundles && npm run sw:manifest",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p sw/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:property": "vitest run tests/property/chw-intent-model.test.ts",
    "test:property:nightly": "cross-env CHW_PROPERTY_NUM_RUNS=1000 vitest run tests/property/chw-intent-model.test.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:integration:flake": "node scripts/check-integration-flake.mjs",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-doc-links.mjs",
    "check:adrs": "node scripts/check-adr-template.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "migration:lint": "node scripts/lint-migrations.mjs",
    "types:verify": "node scripts/verify-supabase-types.mjs",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "secrets:scan-all": "node scripts/scan-secrets.mjs --all",
    "bench:compare": "node scripts/compare-benchmark.mjs",
    "db:reset": "npx supabase db reset",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "hooks:install": "git config core.hooksPath .githooks",
    "ci:check-action-pins": "node scripts/check-action-pins.mjs",
    "ci:check-clean-worktree": "node scripts/check-clean-worktree.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "release:verify-gate": "node scripts/verify-release-gate.mjs",
    "db:audit-rls": "node scripts/audit-rls.mjs",
    "db:drift": "node scripts/check-schema-drift.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.1.0",
    "@stellar/stellar-sdk": "^17.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.2",
    "libphonenumber-js": "^1.13.14",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.12.1",
    "esbuild": "^0.25.0",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.2",
    "vitest-axe": "^0.1.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.11",
    "@rolldown/binding-darwin-x64": "1.2.11",
    "@rolldown/binding-linux-arm64-gnu": "1.2.11",
    "@rolldown/binding-linux-arm64-musl": "1.2.11",
    "@rolldown/binding-linux-x64-gnu": "1.2.11",
    "@rolldown/binding-linux-x64-musl": "1.2.11",
    "@rolldown/binding-win32-arm64-msvc": "1.2.11",
    "@rolldown/binding-win32-x64-msvc": "1.2.11"
  }
}
