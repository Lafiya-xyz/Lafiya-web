{
  "name": "@lafiya/partner-sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the Lafiya Partner API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": ["dist", "openapi.json", "README.md", "CHANGELOG.md"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check:drift": "node scripts/generate.mjs --check",
    "build": "npm run check:drift && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "^7",
    "vitest": "^5.0.2"
  }
}
